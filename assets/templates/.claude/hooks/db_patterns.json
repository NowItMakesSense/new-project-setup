{
  "_comment": "Regex rule set for .claude/hooks/block-db-access.py. Each cmd_patterns entry is matched (case-insensitive) against the Bash tool's command string; path_pattern is matched against file_path/path/notebook_path/pattern/glob tool-input values unless safe_path also matches. Extend this file to add new DB/secret-access rules instead of editing the hook script's logic.",
  "cmd_patterns": [
    {
      "pattern": "(?:^|[\\s;&|`(\\\"'/\\\\])(?:psql|pg_dump|pg_restore|pg_dumpall|mysql|mysqldump|mysqladmin|mariadb|mongosh|mongo|mongodump|mongorestore|redis-cli|sqlite3|sqlcmd|cqlsh|clickhouse-client|influx|isql|sqlplus|usql|pgcli|mycli|litecli)(?:\\.exe)?(?=$|[\\s;&|`)\\\"'])",
      "label": "database CLI"
    },
    {
      "pattern": "(?:^|[\\s;&|`(\\\"'/\\\\])(?:prisma|alembic|flyway|liquibase|knex|sequelize|typeorm|sequelize-cli|dbmate|goose|atlas|(?:rake|rails)\\s+db:|manage\\.py\\s+(?:migrate|dbshell|shell|flush|loaddata|sqlmigrate)|artisan\\s+(?:migrate|db:)|ef\\s+database|dotnet\\s+ef\\s+database)",
      "label": "database migration/ORM runner"
    },
    {
      "pattern": "(?:docker|podman|kubectl|nerdctl)(?:\\s+compose)?\\s+(?:exec|run|attach)|docker-compose\\s+exec",
      "label": "container exec (can reach the database)"
    },
    {
      "pattern": "aws\\s+secretsmanager\\s+get-secret-value|aws\\s+ssm\\s+get-parameter(?:s(?:-by-path)?)?\\b[^|;&]*--with-decryption|gcloud\\s+secrets\\s+versions\\s+access|az\\s+keyvault\\s+secret\\s+(?:show|download)|vault\\s+(?:read|kv\\s+get)|op\\s+(?:read|item\\s+get)|doppler\\s+(?:secrets\\s+get|run)|pass\\s+show|kubectl\\s+get\\s+secrets?\\b",
      "label": "cloud secret-manager CLI call"
    },
    {
      "pattern": "(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\\+srv)?|redis|rediss|mssql|sqlserver|oracle|cassandra|clickhouse)://",
      "label": "database connection string"
    },
    {
      "pattern": "(?:cat|type|less|more|head|tail|bat|get-content|gc|grep|rg|awk|sed|cp|mv|curl)\\b[^|;&]*(?:^|[\\\\/\\s\\\"'])\\.env(?:\\.[\\w.-]+)?(?:$|[\\s\\\"'])|secrets?[\\\\/]|\\.pem\\b|\\.key\\b|id_rsa|id_ed25519|credentials(?:\\.json)?\\b|\\.pgpass|\\.my\\.cnf|\\.netrc|\\.aws[\\\\/]",
      "label": "secret/credential file access"
    },
    {
      "pattern": "(?:^|[;&|]\\s*)(?:printenv|env|set|export\\s+-p|declare\\s+-x|get-childitem\\s+env:|gci\\s+env:)\\s*(?:$|[;&|])",
      "label": "environment dump (may expose credentials)"
    }
  ],
  "path_pattern": "(?:^|[\\\\/\\s\\\"'])\\.env(?:\\.[\\w.-]+)?(?:$|[\\s\\\"'])|secrets?[\\\\/]|\\.pem\\b|\\.key\\b|id_rsa|id_ed25519|credentials(?:\\.json)?\\b|\\.pgpass|\\.my\\.cnf|\\.netrc|\\.aws[\\\\/]",
  "safe_path": "\\.env\\.(?:example|sample|template)$"
}
