name: CI
on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  quality:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.x"
      - name: Guard-rail check (DB-access deny rules + hook)
        run: python3 .claude/hooks/verify-guard.py
      - name: Spec traceability check (REQ-IDs in requirements.md vs tasks.md)
        run: python3 .claude/scripts/check-traceability.py
      # TODO({{PROJECT_NAME}}): set up the toolchain for the stack: {{STACK}}
      - name: Lint
        run: echo "Run: {{LINT_CMD}}"        # replace once LINT_CMD is decided
      - name: Test
        run: echo "Run: {{TEST_CMD}}"        # replace once TEST_CMD is decided; tests must not use the system DB
      - name: Coverage threshold ({{COVERAGE_THRESHOLD}}%)
        run: echo "Wire this to the stack's coverage tool (pytest-cov/nyc/jacoco/go test -cover) and fail under {{COVERAGE_THRESHOLD}}%"   # devops-docs replaces this once the stack's test tool is set up
      - name: Build
        run: echo "Run: {{BUILD_CMD}}"       # replace once BUILD_CMD is decided
      - name: Secret scan
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
